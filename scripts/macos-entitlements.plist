<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened runtime's one exception for MetaRush (D257, scripts/macos-sign.sh): it loads libraries it didn't
     sign itself (the speech and face models' runtimes: sherpa-onnx and onnxruntime), so library validation is off. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
