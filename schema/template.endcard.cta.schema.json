{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:metarush:template:endcard.cta:1",
  "$ref": "#/$defs/EndCardParams",
  "$defs": {
    "EndCardParams": {
      "properties": {
        "headline": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1
        },
        "subline": {
          "type": "string",
          "maxLength": 120
        },
        "cta": {
          "type": "string",
          "maxLength": 40
        },
        "handle": {
          "type": "string",
          "maxLength": 40
        },
        "logo": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}(#[1-9][0-9]{0,2})?$",
          "format": "metarush-resource",
          "description": "A logo from the cut's resources, above the headline."
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}(#[1-9][0-9]{0,2})?$",
          "format": "metarush-resource",
          "description": "A picture from the cut's resources behind the card (a PDF page: name#3)."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "headline"
      ]
    }
  },
  "title": "Params for endcard.cta"
}
