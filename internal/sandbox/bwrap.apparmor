# MetaRush: lets bubblewrap make its own sandbox where AppArmor allows only
# listed programs to (Ubuntu 23.10 and later). Save as /etc/apparmor.d/bwrap
# and load with: sudo apparmor_parser -r /etc/apparmor.d/bwrap
abi <abi/4.0>,
include <tunables/global>

profile bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,

  include if exists <local/bwrap>
}
