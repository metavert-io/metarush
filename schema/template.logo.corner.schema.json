{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:metarush:template:logo.corner:1",
  "$ref": "#/$defs/LogoCornerParams",
  "$defs": {
    "LogoCornerParams": {
      "properties": {
        "logo": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]{0,47}(#[1-9][0-9]{0,2})?$",
          "format": "metarush-resource",
          "description": "A logo from the cut's resources."
        },
        "corner": {
          "type": "string",
          "enum": [
            "top-right",
            "top-left",
            "bottom-right",
            "bottom-left"
          ],
          "description": "Default top-right."
        },
        "size": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "description": "Default small (about a tenth of the frame's width)."
        },
        "opacity": {
          "type": "number",
          "maximum": 1,
          "minimum": 0.2,
          "description": "Default 0.9."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "logo"
      ]
    }
  },
  "title": "Params for logo.corner"
}
