<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  MetaRush.app's Info.plist. scripts/mac-app.sh build fills in the __NAMES__ (D477, D479):
  the version (scripts/version.sh) and the bundle version Sparkle compares (scripts/macapp
  bundle-version), the bundle identifier (derived from the repository unless the build is given
  one), the feed address (the repository's latest release unless given another) and the update
  key: the EdDSA public key of the release Mac (Sparkle's generate_keys, or one given to the
  build). The key stays this placeholder in the repository; a build without a real one never
  updates (docs/mac-app.md).
-->
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>MetaRush</string>
	<key>CFBundleDisplayName</key>
	<string>MetaRush</string>
	<key>CFBundleExecutable</key>
	<string>MetaRush</string>
	<key>CFBundleIdentifier</key>
	<string>__BUNDLE_ID__</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUNDLE_VERSION__</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.video</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>MetaRush is MIT-licensed. Third-party software: THIRD_PARTY.md in the app.</string>
	<key>MetaRushCommit</key>
	<string>__COMMIT__</string>
	<key>SUFeedURL</key>
	<string>__FEED_URL__</string>
	<key>SUPublicEDKey</key>
	<string>__ED_PUBLIC_KEY__</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
