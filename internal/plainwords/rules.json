  "_panel": "Stricter rules for what the Claude Code panel shows (D140: step lines, cards, notes), on top of the rules above: Claude's work is described by what it means for the video, never by its files, tools or versions. Go: plainwords.CheckPanel; dashboard scripts: checkPanel.",
  "panel": [
    {"kind": "file", "pattern": "\\b[\\w-]+(?:\\.[\\w-]+)*\\.(?:tsx|ts|jsx|js|mjs|json|txt|output|go|py|md|yaml|yml|sh)\\b", "plain": "say what it is (a graphic, a change, the rest of a long result), not its file name"},
    {"kind": "version-code", "pattern": "\\b[a-z][a-z0-9-]*@[0-9a-f]{6,64}\\b", "plain": "the graphic's name (the exact version stays in Details)"},
    {"kind": "time", "pattern": "\\b\\d{1,3}:\\d{2}\\.\\d{2,3}\\b", "plain": "a time to the second (around 13:11)"},
    {"kind": "tool", "pattern": "\\btoolu_[A-Za-z0-9]+|\\bblocked\\b|\\blines? of code\\b|\\bmeta\\.[A-Za-z]+|\\bRan a command\\b|\\bSKILL\\b|\\bResumed the Claude Code session\\b", "plain": "what happened, in words about the video"},
    {"kind": "picture-path", "pattern": "(?:^|[\\s(])(?:scratch|cache|assistant|frames|sheets)/[\\w./@-]+", "plain": "show the picture; don't print where it is"},
    {"kind": "command", "pattern": "\\brun it: |\\bmetarush assistant act\\b", "plain": "the card's own button (the command stays behind --details)"}
  ]
}
