{
  "name": "@metarush/video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MetaRush Remotion package: renders a Go-resolved RenderPlan verbatim (dashboard preview via @remotion/player, final renders via render/render.mjs).",
  "exports": {
    "./lib": "./src/lib.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts --port 4842",
    "typecheck": "tsc --noEmit",
    "render:selftest": "node render/selftest.mjs",
    "browser:ensure": "remotion browser ensure",
    "test:motion": "node render/motion/test.mjs && node render/web/test.mjs && node render/source/test.mjs",
    "motion": "node render/motion.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@metarush/schema": "*",
    "@remotion/bundler": "4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/layout-utils": "4.0.536",
    "@remotion/paths": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "@remotion/shapes": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "@remotion/zod-types": "4.0.536",
    "esbuild": "0.28.1",
    "mermaid": "12.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remotion": "4.0.536",
    "shiki": "4.5.0",
    "typescript": "5.9.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@remotion/player": "4.0.536",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
