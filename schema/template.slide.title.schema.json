{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:metarush:template:slide.title:1",
  "$ref": "#/$defs/SlideTitleParams",
  "$defs": {
    "SlideTitleParams": {
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 90,
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "maxLength": 140
        },
        "kicker": {
          "type": "string",
          "maxLength": 40,
          "description": "A short label above the title (Part 2, How it works)."
        },
        "logo": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}(#[1-9][0-9]{0,2})?$",
          "format": "metarush-resource",
          "description": "A logo from the cut's resources, above the title."
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}(#[1-9][0-9]{0,2})?$",
          "format": "metarush-resource",
          "description": "A picture behind the title, darkened (a page snapshot, a photo)."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "title"
      ]
    }
  },
  "title": "Params for slide.title"
}
