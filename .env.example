# Copy to <installation home>/.env (chmod 600) or export in your shell. Never commit real values.
METARUSH_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# METARUSH_DATABASE_NAME=metarush
# S3-compatible media store (Tigris shown; secrets only via env or keychain)
# METARUSH_S3_ACCESS_KEY_ID=
# METARUSH_S3_SECRET_ACCESS_KEY=
# Optional overrides
# METARUSH_HOME=~/.metarush
# METARUSH_DASHBOARD_PORT=4845
# METARUSH_VIDEO_DIR=/path/to/metarush/video
