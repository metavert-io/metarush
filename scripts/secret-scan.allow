# Allowlist for scripts/secret-scan.sh: one extended regex per line, matched
# against "path:line:text" of each hit. Keep entries narrow: documented
# placeholders and obviously fake test values only. Never allowlist a real key.

# Placeholder hosts used in docs and tests (example/abcde clusters).
mongodb(\+srv)?://[^@]+@(cluster0\.)?(example|abcde)\.mongodb\.net
mongodb(\+srv)?://u:p@c\.mongodb\.net
# Obviously fake key IDs in unit tests.
_test\.go:[0-9]+:.*tid_abcdefghijklmnop
